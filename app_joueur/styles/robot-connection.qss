QWidget {
    background-color: #f4f8ff;
    font-family: "Roboto";
}

QMainWindow {
    background-color: #f4f8ff;
}

/* Carte blanche centrale */
QWidget#form_card {
    background-color: #ffffff;
    border-radius: 14px;
    border: 1px solid #c8d8f0;
}

/* Titre principal */
QLabel#heading {
    font-size: 17px;
    font-weight: 500;
    color: #1a2a4a;
}

/* Sous-titre */
QLabel#subheading {
    font-size: 12px;
    color: #8899bb;
}

/* Label "ADRESSE IP" */
QLabel#input_label {
    font-size: 11px;
    font-weight: 600;
    color: #4a5a7a;
    letter-spacing: 1px;
}

/* Statut de connexion */
QLabel#status {
    font-size: 12px;
    color: #aabbcc;
}

QLabel#status_ok {
    font-size: 12px;
    color: #3dbfa0;
}

QLabel#status_error {
    font-size: 12px;
    color: #e05a5a;
}

/* Champ texte IP */
QLineEdit {
    background-color: #f4f7ff;
    border: 1.5px solid #c8d8f0;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    color: #1a2a4a;
}

QLineEdit:focus {
    border: 1.5px solid #6395EE;
}

/* Bouton principal — Se connecter */
QPushButton#btn_primary {
    background-color: #6395EE;
    color: #ffffff;
    border-radius: 9px;
    border: none;
    padding: 11px 0px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#btn_primary:hover {
    background-color: #4d7ee0;
}

QPushButton#btn_primary:pressed {
    background-color: #3a6dd0;
}

/* Bouton secondaire — Recherche automatique */
QPushButton#btn_secondary {
    background-color: #eef6f4;
    color: #3dbfa0;
    border-radius: 9px;
    border: 1.5px solid #85DECB;
    padding: 10px 0px;
    font-size: 13px;
}

QPushButton#btn_secondary:hover {
    background-color: #d8f0eb;
}

#btn_forward, #btn_backward, #btn_left, #btn_right {
    border-radius: 50px;           
    background-color: #6395EE;    
    color: white;                 
    font-size: 24px;              
    font-weight: bold;
    min-width: 80px;
    min-height: 80px;
    border: 2px solid #3a7bd5; 
}

#btn_forward:hover, #btn_backward:hover, #btn_left:hover, #btn_right:hover {
    background-color: #3a7bd5;   
}

/* Boutons bras */
QPushButton#btn_arm {
    background-color: #90B8D6;
    color: #ffffff;
    border-radius: 8px;
    border: none;
    padding: 10px 8px;
    font-size: 12px;
    font-weight: 500;
    min-width: 120px;
}
QPushButton#btn_arm:hover {
    background-color: #6395EE;
}

/* Boutons expressions */
QPushButton#btn_expr {
    background-color: #eef6f4;
    color: #3dbfa0;
    border-radius: 8px;
    border: 1.5px solid #85DECB;
    padding: 10px 14px;
    font-size: 13px;
}
QPushButton#btn_expr:hover {
    background-color: #d8f0eb;
}

/* Bouton importer .dance */
QPushButton#btn_import {
    background-color: #88CFA8;
    color: #ffffff;
    border-radius: 8px;
    border: none;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#btn_import:hover {
    background-color: #6ab88a;
}

/* Label batterie */
QLabel#battery_label {
    font-size: 13px;
    color: #4a5a7a;
    font-weight: 500;
    padding: 6px 12px;
    background-color: #ffffff;
    border-radius: 8px;
    border: 1px solid #c8d8f0;
}
/* Boutons bras — carrés */
QPushButton#btn_arm {
    background-color: #f0f5ff;
    border-radius: 8px;
    border: 1.5px solid #c8d8f0;
    min-width: 70px;
    min-height: 70px;
}
QPushButton#btn_arm:hover {
    background-color: #d8e8ff;
    border-color: #6395EE;
}

/* Boutons expressions — carrés avec emoji */
QPushButton#btn_expr {
    background-color: #f0f5ff;
    border-radius: 8px;
    border: 1.5px solid #c8d8f0;
    font-size: 28px;
    min-width: 70px;
    min-height: 70px;
}
QPushButton#btn_expr:hover {
    background-color: #eef6f4;
    border-color: #85DECB;
}

/* Bouton stand_straight */
QPushButton#btn_stand {
    background-color: #88CFA8;
    color: white;
    border-radius: 8px;
    border: none;
    font-size: 18px;
    min-width: 60px;
    min-height: 60px;
}
QPushButton#btn_stand:hover {
    background-color: #6ab88a;
}

QComboBox {
    background-color: #f4f7ff;
    border: 1.5px solid #c8d8f0;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    color: #1a2a4a;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a2a4a;
    selection-background-color: #6395EE;
    selection-color: #ffffff;
    border: 1px solid #c8d8f0;
}